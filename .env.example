# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# `docker compose up --build` reads .env automatically. Never commit your
# real .env file - it's already in .gitignore.

# --- Database ---------------------------------------------------------
# In Docker Compose this is overridden to point at the `postgres` service -
# you don't need to set it there. Only used directly if you run the backend
# outside Docker (e.g. `uvicorn app.main:app` from your own shell).
DATABASE_URL=postgresql+psycopg2://perf:perf@localhost:5433/perf_intelligence

# --- PageSpeed Insights -------------------------------------------------
# "mock" (default) needs no API key and returns realistic demo data.
# Switch to "real" to call the actual Google PSI API.
PSI_PROVIDER=mock
PSI_API_KEY=
PSI_STRATEGY=mobile

# --- LLM synthesis -------------------------------------------------------
# "mock" (default) needs no API key and returns deterministic sample
# recommendations. Switch to "openai" to call the real OpenAI API.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Raw PSI storage ----------------------------------------------------
STORAGE_MODE=local

# --- Scheduler -----------------------------------------------------------
RUN_INTERVAL_HOURS=6
AUTO_LLM_ANALYSIS=false
SCHEDULER_ENABLED=true

# --- Frontend -------------------------------------------------------------
# URL the BROWSER uses to reach the backend (published host port). Baked
# into the frontend build - change it and rebuild the frontend if your setup
# differs from the default `docker compose up` on localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
